    {
      "id": "dangerous_api_scan",
      "name": "危险 API / 调用模式静态扫描",
      "category": "analysis",
      "kind": "tool",
      "status": "active",
      "version": "1.0.0",
      "summary": "扫描仓库中『取原始资源的变量被危险方法直接调用且未经包装』的模式；规则数据化、可 --rules 注入适配任意框架。退出码 0/1 可作 CI 红线。",
      "entry": "repo_lucent.scriptlib.dangerous_api_scan",
      "inputs": [
        {
          "name": "--root",
          "type": "path",
          "required": false,
          "default": ".",
          "desc": "扫描根目录"
        },
        {
          "name": "--rules",
          "type": "file",
          "required": false,
          "default": "builtin",
          "desc": "外部规则 JSON（缺省用内置 raw_db_conn_execute 等）"
        },
        {
          "name": "--json",
          "type": "flag",
          "required": false,
          "desc": "结构化输出"
        },
        {
          "name": "--fail-on-hit",
          "type": "flag",
          "required": false,
          "desc": "命中即退出码 1（CI 语义显式化）"
        }
      ],
      "outputs": {
        "stdout": "命中清单 [rule] file:line: snippet",
        "json": "{root,count,hits[]}",
        "exit": "0 无命中 / 1 有命中 / 2 参数错"
      },
      "deps": {
        "stdlib_only": true,
        "third_party": [],
        "network": false,
        "needs_repo": false
      },
      "reuses_platform": [
        "repo_lucent.config.DEFAULT_EXCLUDE_DIRS"
      ],
      "overlap": "与 gate.py 既有门禁互补（gate 管体量/结构，本脚本管跨行调用链误用）",
      "usage": "repolucent.py script run dangerous_api_scan --root <repo> --fail-on-hit",
      "notes": "内置规则针对数据库裸连接；适配其它框架请提供 --rules JSON。只读，不改源文件。",
      "tags": [
        "ast-like",
        "regex",
        "ci",
        "lint"
      ],
